+    
+    # Stream git cat-file to avoid buffering 1.2+ GB into memory (fixes 2.4 GiB OOM / Exit 137)
+    import threading
+    proc = subprocess.Popen(["git", "-C", repo, "cat-file", "--batch"],
+                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=65536)
+    
+    def feeder():
+        try:
+            for o in objs:
+                proc.stdin.write(o.encode() + b"\n")
+            proc.stdin.close()
+        except (BrokenPipeError, OSError):
+            pass
+            
+    t = threading.Thread(target=feeder, daemon=True)
+    t.start()
+    
+    result = set()
+    stdout = proc.stdout
+    while True:
+        line = stdout.readline()
+        if not line:
+            break
+        header = line.split()
+        if len(header) < 3 or header[1] == b"missing":
+            continue
+        size = int(header[2])
+        prefix = stdout.read(2)
+        if prefix == b"#!":
+            result.add(header[0].decode())
+            rem = size - 2
+        else:
+            rem = size - len(prefix)
+        to_skip = rem + 1
+        while to_skip > 0:
+            chunk = stdout.read(min(to_skip, 65536))
+            if not chunk:
+                break
+            to_skip -= len(chunk)
+            
+    t.join()
+    proc.wait()
     return result
