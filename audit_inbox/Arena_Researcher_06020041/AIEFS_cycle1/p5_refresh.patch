+    half = simulate(0.5, zero, 1, [0.0, 0.0], u, [0.0, 0.0], 0.0, 1)
+    assert abs(half[1][0][0] - 0.5) < 1e-12                       # alpha = 1/2 is self-dual: blind to the swap
