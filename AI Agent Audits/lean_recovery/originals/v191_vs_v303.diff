> /-- The complementary images intersect only at the origin. -/
> theorem im_PPar_inter_im_PPerp
>     (x : Fin 3 → ℚ)
>     (hPar : ∃ y, PPar *ᵥ y = x)
>     (hPerp : ∃ z, PPerp *ᵥ z = x) :
